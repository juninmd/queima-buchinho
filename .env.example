# Queima Buchinho - Environment Variables

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID (onde a Mika ENVIA as mensagens — grupo ou privado)
CHAT_ID=your_chat_id_here

# Seu Telegram User ID PESSOAL (dono dos hábitos/água/treino).
# Em GRUPO, CHAT_ID é o id do grupo e difere do seu id pessoal: sem USER_ID, os
# relatórios do cron leem 0/12. Em chat privado pode omitir (cai no CHAT_ID).
USER_ID=your_personal_telegram_user_id

# Ollama LLM Service
OLLAMA_HOST=http://localhost:11434

# LiteLLM/OpenAI Compatible API configuration
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_BASE_URL=https://your-litellm-domain.com/v1
AI_MODEL=cloud/llama-70b

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/queima_buchinho

# Redis Cache
REDIS_URL=redis://localhost:6379

# Giphy API Key (get from https://developers.giphy.com/)
# The public beta key is BANNED - you need your own key
GIPHY_API_KEY=your_giphy_api_key_here

# User birthday (DD/MM/YYYY) — Mika celebrates with GIF, sticker, sounds and voice at 9am
USER_BIRTHDAY=14/06/1995

# Dashboard API (progresso diário/semanal/mensal consumido pelo frontend em dashboard/)
# Sem DASHBOARD_TOKEN, a API fica desativada.
DASHBOARD_TOKEN=your_dashboard_bearer_token_here
DASHBOARD_PORT=8081
DASHBOARD_CORS_ORIGIN=http://localhost:5173

# App (PWA): a API serve o build de dashboard/dist na mesma porta (PWA_DIST_DIR sobrescreve o caminho).
# Em produção use HTTPS (exigido por service worker, push e pelo app Android/TWA) e restrinja a origem.
PWA_DIST_DIR=./dashboard/dist

# Web Push (lembretes no celular). Gere o par com: npx web-push generate-vapid-keys
# Sem as duas chaves, as notificações push ficam desativadas.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com
