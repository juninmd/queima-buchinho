# Opcional. Em produção o PWA é servido pelo próprio bot (mesma origem), então nada aqui é necessário:
# o app pede a URL e o token na primeira abertura e guarda só no aparelho.
#
# Só para `bun run dev` (Vite em :5173 falando com a API em outra porta):
VITE_API_URL=http://localhost:8081
# Deve bater com DASHBOARD_TOKEN do .env do bot. NUNCA use em build de produção:
# variáveis VITE_* vão para o bundle público.
VITE_API_TOKEN=your_dashboard_bearer_token_here
